# Malayalam transcription
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix
SARVAM_LANGUAGE_CODE=ml-IN
CBS_SARVAM_TRANSPORT=batch

# Model provider binaries (optional overrides)
CBS_CODEX_BIN=
CBS_CLAUDE_BIN=
CBS_GROK_BIN=

# Kimi K2.6 API
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
CBS_KIMI_MODEL=kimi-k2.6

# Optional xAI API media fallback. Grok CLI media is the default.
XAI_API_KEY=
CBS_XAI_IMAGE_MODEL=grok-imagine-image
CBS_XAI_VIDEO_MODEL=grok-imagine-video

# Timeouts
CBS_MODEL_TIMEOUT_SECONDS=2400
CBS_GROK_MEDIA_TIMEOUT_SECONDS=3600

# Renderer
CBS_HYPERFRAMES_BIN=
CBS_FFMPEG_BIN=
CBS_FFPROBE_BIN=

# Project storage. Defaults to ./runs
CBS_RUNS_ROOT=
