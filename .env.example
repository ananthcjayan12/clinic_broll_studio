# Malayalam transcription
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_LANGUAGE_CODE=mal

# Model provider binaries (optional overrides)
CBS_CODEX_BIN=
CBS_CLAUDE_BIN=
CBS_GROK_BIN=

# Kimi K2.6 API
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
CBS_KIMI_MODEL=kimi-k2.6

# Local CC0 sound-effects library.
# Clone https://github.com/ananthcjayan12/ai_sound_effects_library beside this repo,
# or set the absolute path here.
SFX_LIBRARY_ROOT=../ai_sound_effects_library

# Optional xAI API media fallback. Grok CLI media is the default.
XAI_API_KEY=
CBS_XAI_IMAGE_MODEL=grok-imagine-image
CBS_XAI_VIDEO_MODEL=grok-imagine-video

# Timeouts
CBS_MODEL_TIMEOUT_SECONDS=2400
CBS_GROK_MEDIA_TIMEOUT_SECONDS=3600

# Renderer
CBS_HYPERFRAMES_BIN=
CBS_FFMPEG_BIN=
CBS_FFPROBE_BIN=

# Project storage. Defaults to ./runs
CBS_RUNS_ROOT=
