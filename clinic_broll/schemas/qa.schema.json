{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "findings"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "needs_review",
        "fail"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 1000
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "message",
          "slot_id"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 500
          },
          "slot_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
